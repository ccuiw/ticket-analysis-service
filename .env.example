# Server
HOST=127.0.0.1
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:5173

# LLM Provider
# 可选值：mock（默认，无需 API Key）、openai_compatible
LLM_PROVIDER=mock

# OpenAI-compatible Provider 配置（仅 LLM_PROVIDER=openai_compatible 时需要）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Prompts directory
PROMPTS_DIR=prompts

# DO NOT put real API keys here.
# Copy this file to .env and fill in real values.
